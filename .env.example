# ── Firebase (projecto separado do Real Stiles) ──
FIREBASE_PROJECT_ID=tradeflow-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tradeflow-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Admin ──
# Token do header x-admin-token (clientes server-to-server: scripts, cookies, stripe). Gerar com: openssl rand -hex 32
ADMIN_SECRET=
# Segredo p/ assinar o JWT do login admin (email/password). Gerar com: openssl rand -hex 32
JWT_SECRET=

# ── Servidor ──
PORT=3004
APP_URL=https://tradeflow.pt

# ── Browser pool (Playwright) ──
BROWSER_POOL_SIZE=3
BROWSER_HEADLESS=true

# ── Scraping sidecar (serviço interno) ──
SIDECAR_URL=https://lavi-system-product-name.taild88dae.ts.net
SIDECAR_API_KEY=
NOVNC_URL=https://lavi-system-product-name.taild88dae.ts.net/vnc
COOKIE_CAPTURE_TOKEN=
CALLBACK_SECRET=

# ── Extractores ──
ANTHROPIC_API_KEY=
EVOMI_API_KEY=

# ── Email (Gmail app password) ──
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (Stripe Dashboard → Products)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_PACK_S=price_...
STRIPE_PRICE_PACK_M=price_...
STRIPE_PRICE_PACK_L=price_...
STRIPE_PRICE_WHATSAPP=price_...
